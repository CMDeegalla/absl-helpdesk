# Security headers for Netlify / Cloudflare Pages.
# Vercel reads vercel.json instead; keep the two in step.

/*
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob: https://qfcieerkcrxzsorjzhjq.supabase.co; media-src 'self' blob: https://qfcieerkcrxzsorjzhjq.supabase.co; connect-src 'self' https://qfcieerkcrxzsorjzhjq.supabase.co wss://qfcieerkcrxzsorjzhjq.supabase.co; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'; upgrade-insecure-requests
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(self), microphone=(self), camera=(), payment=(), usb=(), interest-cohort=()
  Cross-Origin-Opener-Policy: same-origin

/vendor/*
  Cache-Control: public, max-age=31536000, immutable

/config.js
  Cache-Control: no-store
